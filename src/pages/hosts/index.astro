---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import HostsHeader from '../../components/hosts/HostsHeader.astro';
import HostsLandingCore from '../../components/hosts/HostsLandingCore.astro';
import HostsFooter from '../../components/hosts/HostsFooter.astro';

const entries = await getCollection('hosts');
const pageEs = entries.find((e: CollectionEntry<'hosts'>) => e.id === 'es');
const pageEn = entries.find((e: CollectionEntry<'hosts'>) => e.id === 'en');

const metaSource = pageEn?.data.hero.subtitle ?? '';
const metaDescription = metaSource.length > 160 ? `${metaSource.slice(0, 157)}…` : metaSource;
---

<Layout title="Slowork Hosts" lang="en" description={metaDescription}>
  <HostsHeader />

  <div
    id="hosts-panel-en"
    data-lang-panel="en"
    class="flex min-h-0 min-w-0 flex-1 flex-col"
  >
    <main class="w-full flex-1">
      {pageEn ? (
        <HostsLandingCore landing={pageEn.data} lang="en" idPrefix="en-" />
      ) : null}
    </main>
    <HostsFooter lang="en" />
  </div>

  <div
    id="hosts-panel-es"
    data-lang-panel="es"
    hidden
    class="flex min-h-0 min-w-0 flex-1 flex-col"
  >
    <main class="w-full flex-1">
      {pageEs ? (
        <HostsLandingCore landing={pageEs.data} lang="es" idPrefix="es-" />
      ) : null}
    </main>
    <HostsFooter lang="es" />
  </div>
</Layout>
