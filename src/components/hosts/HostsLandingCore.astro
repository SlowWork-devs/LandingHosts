---
import type { CollectionEntry } from 'astro:content';
import VideoFacade from './VideoFacade.astro';

interface Props {
  landing: CollectionEntry<'hosts'>['data'];
  lang: 'es' | 'en';
  idPrefix?: string;
  posterLoading?: 'eager' | 'lazy';
}

const { landing, lang, idPrefix = '', posterLoading = 'eager' } = Astro.props;
const pid = idPrefix;

const { hero, problem, whatIs, whyJoin, whoFor, howItWorks, different, whatYouGet, afterApply, faq, finalCta, video } =
  landing;

const stackClass = 'gap-20 py-24 md:gap-28 md:py-32 lg:gap-32 lg:py-40';

const cardClass =
  'group flex flex-col items-start rounded-2xl border border-primary/10 bg-white/40 p-6 shadow-sm backdrop-blur-sm transition-all duration-300 ease-out hover:-translate-y-1 hover:scale-[1.02] hover:bg-white/60 hover:shadow-md';

const ctaButtonClass =
  'inline-flex min-h-[3.5rem] items-center justify-center rounded-full bg-secondary px-12 py-4 text-lg font-semibold text-primary shadow-[0_8px_30px_-6px_rgba(234,179,8,0.65)] transition-all duration-300 ease-out hover:-translate-y-1 hover:scale-105 hover:shadow-[0_12px_40px_-6px_rgba(234,179,8,0.85)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary active:scale-[0.98]';

const proseClass = 'max-w-[62ch] text-lg font-light leading-[1.8] text-primary/85 md:text-xl';
const h2Class = 'text-3xl font-bold tracking-tight text-primary md:text-4xl';
---

<div class:list={['flex flex-col', stackClass]}>
  <!-- Hero -->
  <section class="flex flex-col items-center gap-8 px-2 text-center" aria-labelledby={`${pid}hosts-hero-title`}>
    <h1
      id={`${pid}hosts-hero-title`}
      class="max-w-[28ch] text-[clamp(2.25rem,6vw+1rem,4.5rem)] font-bold italic leading-[1.05] tracking-tight text-primary md:max-w-[36ch]"
    >
      {hero.title}
    </h1>
    <p id={`${pid}hosts-subtitle`} class:list={[proseClass, 'text-center']}>
      {hero.subtitle}
    </p>
    <div class="flex flex-col items-center gap-4">
      <a href={hero.ctaHref} class={ctaButtonClass}>
        {hero.cta}
      </a>
      <p class="max-w-[48ch] text-sm font-medium leading-relaxed text-primary/75 md:text-base">
        {hero.microcopy}
      </p>
    </div>
  </section>

  <!-- Problem -->
  <section class="flex flex-col gap-6 px-2" aria-labelledby={`${pid}problem-heading`}>
    <h2 id={`${pid}problem-heading`} class={h2Class}>
      {problem.heading}
    </h2>
    <div class="flex flex-col gap-4">
      {problem.bodyParagraphs.map((p) => (
        <p class={proseClass}>{p}</p>
      ))}
    </div>
    <ul class="list-disc space-y-2 pl-6 text-base font-light text-primary/85 md:text-lg">
      {problem.points.map((item) => (
        <li class="pl-1">{item}</li>
      ))}
    </ul>
    <p class={`${proseClass} font-medium text-primary`}>{problem.closing}</p>
  </section>

  <!-- What is Slowork -->
  <section
    id={`${pid}manifesto`}
    class="flex flex-col gap-6 px-2"
    aria-labelledby={`${pid}whatis-heading`}
  >
    <h2 id={`${pid}whatis-heading`} class={h2Class}>
      {whatIs.heading}
    </h2>
    <div class="flex flex-col gap-4">
      {whatIs.paragraphs.map((p) => (
        <p class={proseClass}>{p}</p>
      ))}
    </div>
    <p class={`${proseClass} font-medium text-primary`}>{whatIs.closing}</p>
  </section>

  <!-- Why join -->
  <section class="flex flex-col gap-8 px-2" aria-labelledby={`${pid}why-heading`}>
    <h2 id={`${pid}why-heading`} class={h2Class}>
      {whyJoin.heading}
    </h2>
    <p class={proseClass}>{whyJoin.intro}</p>
    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2 lg:gap-8">
      {whyJoin.benefits.map((b) => (
        <div class={cardClass}>
          <h3 class="mb-2 text-lg font-semibold text-primary">{b.title}</h3>
          <p class="text-sm font-light leading-relaxed text-primary/75 md:text-base">{b.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Who for -->
  <section class="flex flex-col gap-8 px-2" aria-labelledby={`${pid}who-heading`}>
    <h2 id={`${pid}who-heading`} class={h2Class}>
      {whoFor.heading}
    </h2>
    <p class={proseClass}>{whoFor.intro}</p>
    <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2 lg:gap-8">
      {whoFor.profiles.map((b) => (
        <div class={cardClass}>
          <h3 class="mb-2 text-lg font-semibold text-primary">{b.title}</h3>
          <p class="text-sm font-light leading-relaxed text-primary/75 md:text-base">{b.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- How it works -->
  <section class="flex flex-col gap-8 px-2" aria-labelledby={`${pid}how-heading`}>
    <h2 id={`${pid}how-heading`} class={h2Class}>
      {howItWorks.heading}
    </h2>
    <p class={proseClass}>{howItWorks.intro}</p>
    <ol class="flex flex-col gap-6 md:gap-8">
      {howItWorks.steps.map((step, i) => (
        <li class="flex gap-4 rounded-2xl border border-primary/10 bg-white/30 p-6 md:gap-6">
          <span
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-secondary/90 text-base font-bold text-primary"
            aria-hidden="true"
          >
            {i + 1}
          </span>
          <div class="min-w-0">
            <h3 class="text-lg font-semibold text-primary">{step.title}</h3>
            <p class="mt-2 text-sm font-light leading-relaxed text-primary/75 md:text-base">{step.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Different -->
  <section class="flex flex-col gap-6 px-2" aria-labelledby={`${pid}diff-heading`}>
    <h2 id={`${pid}diff-heading`} class={h2Class}>
      {different.heading}
    </h2>
    <div class="flex flex-col gap-4">
      {different.paragraphs.map((p) => (
        <p class={proseClass}>{p}</p>
      ))}
    </div>
    <p class="text-base font-semibold text-primary md:text-lg">{different.bulletsLead}</p>
    <ul class="list-disc space-y-2 pl-6 text-base font-light text-primary/85 md:text-lg">
      {different.bullets.map((item) => (
        <li class="pl-1">{item}</li>
      ))}
    </ul>
  </section>

  <!-- What you get -->
  <section class="flex flex-col gap-6 px-2" aria-labelledby={`${pid}get-heading`}>
    <h2 id={`${pid}get-heading`} class={h2Class}>
      {whatYouGet.heading}
    </h2>
    <p class={proseClass}>{whatYouGet.intro}</p>
    <p class="text-base font-semibold text-primary md:text-lg">{whatYouGet.bulletsLead}</p>
    <ul class="list-disc space-y-2 pl-6 text-base font-light text-primary/85 md:text-lg">
      {whatYouGet.bullets.map((item) => (
        <li class="pl-1">{item}</li>
      ))}
    </ul>
  </section>

  <!-- After apply -->
  <section class="flex flex-col gap-6 px-2" aria-labelledby={`${pid}after-heading`}>
    <h2 id={`${pid}after-heading`} class={h2Class}>
      {afterApply.heading}
    </h2>
    <p class={proseClass}>{afterApply.intro}</p>
    <p class="text-base font-semibold text-primary md:text-lg">{afterApply.bulletsLead}</p>
    <ul class="list-disc space-y-2 pl-6 text-base font-light text-primary/85 md:text-lg">
      {afterApply.bullets.map((item) => (
        <li class="pl-1">{item}</li>
      ))}
    </ul>
    <p class={`${proseClass} font-medium text-primary`}>{afterApply.closing}</p>
  </section>

  <!-- FAQ -->
  <section class="flex flex-col gap-10 px-2" aria-labelledby={`${pid}faq-heading`}>
    <h2 id={`${pid}faq-heading`} class={h2Class}>
      {faq.heading}
    </h2>
    <div class="flex flex-col gap-10">
      {faq.items.map((item) => (
        <div>
          <h3 class="text-lg font-semibold text-primary md:text-xl">{item.question}</h3>
          <p class={`${proseClass} mt-3 max-w-none text-base md:text-lg`}>{item.answer}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Final CTA -->
  <section
    id={`${pid}join`}
    class="flex flex-col items-center gap-8 rounded-3xl border border-primary/15 bg-white/35 px-4 py-14 text-center shadow-sm backdrop-blur-sm md:px-10 md:py-16"
    aria-labelledby={`${pid}final-heading`}
  >
    <h2 id={`${pid}final-heading`} class:list={[h2Class, 'max-w-[22ch] md:max-w-[28ch]']}>
      {finalCta.heading}
    </h2>
    <div class="flex max-w-[54ch] flex-col gap-4">
      {finalCta.paragraphs.map((p) => (
        <p class:list={[proseClass, 'text-center']}>{p}</p>
      ))}
    </div>
    <a href={finalCta.ctaHref} class={ctaButtonClass}>
      {finalCta.cta}
    </a>
    <div class="flex max-w-[42ch] flex-col gap-2 text-base font-medium text-primary/85 md:text-lg">
      {finalCta.closingLines.map((line) => (
        <p>{line}</p>
      ))}
    </div>
  </section>

  <!-- Optional video -->
  {video?.videoId ? (
    <section class="w-full px-0" aria-label={video.title}>
      <VideoFacade
        videoId={video.videoId}
        videoTitle={video.title}
        posterUrl={video.posterUrl}
        lang={lang}
        posterLoading={posterLoading}
      />
    </section>
  ) : null}
</div>
